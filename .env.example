# ==============================================================================
# DisputeDesk Environment Configuration
# HARD RULE: SANDBOX ONLY. PAYPAL_API_BASE must contain "sandbox".
# Never put real production credentials or commit secrets.
# Copy this file to .env.local and fill in your values.
# ==============================================================================

# PayPal Sandbox Configuration
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Application Data Mode
# live: connect only to PayPal sandbox API (fails if credentials missing)
# demo: use local synthetic demo data for disputes and documents
# auto: try live sandbox first; automatically fall back to demo data if credentials not configured
DATA_MODE=auto

# LLM Provider Configuration (provider-agnostic)
# Options: "gemini" (Google AI Studio REST) | "openai-compatible" (any OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Model Identifiers (MUST NOT be hardcoded in application code)
# Example Gemini: gemini-2.5-flash or gemini-1.5-flash
# Example OpenAI-compatible: gpt-4o-mini
LLM_MODEL_PRIMARY=gemini-2.5-flash
LLM_MODEL_FAST=gemini-2.5-flash

# Multimodal / Vision Capability
# auto: autodetect based on provider; true: force vision enabled; false: text-only mode
LLM_VISION=auto

# Agent Loop Execution Bounds
MAX_AGENT_STEPS=6
MAX_LLM_CALLS_PER_ANALYSIS=12
ANALYSIS_TIMEOUT_MS=60000

# Daily Analysis Safety Cap
DAILY_ANALYSIS_CAP=15

# Upstash Redis (Optional - for distributed rate limiting in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

